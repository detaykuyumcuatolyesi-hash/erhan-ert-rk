 for(const [us,eu] of sizes){const a=document.createElement('option');a.value=String(us);a.textContent='US '+us;$('#us-size').append(a);const b=document.createElement('option');b.value=String(us);b.textContent='EU ≈ '+eu;$('#size').append(b)}
 $('#us-size').value=String(state.us);$('#size').value=String(state.us);
 $('#size-note').textContent='US '+state.us+' / yaklaşık EU '+sizes.find(x=>x[0]===state.us)[1]+'. İki alan aynı ölçüyü gösterir; birini değiştirince diğeri güncellenir. Listedeki ölçüler rehberde doğrulanan eşleştirmelerdir.'
}
function priceParts(){const baseVariant=state.product?.variants.find(v=>state.product.options.every((o,i)=>/purity/i.test(o.name)?v['option'+(i+1)]==='14K':v['option'+(i+1)]===state.options[i]));const base=Math.round(Number(baseVariant?.price||activeVariant?.price||0)*100),color=({D:4000,E:3000,F:2000})[state.color]||0,clarity=state.clarity==='VS1'?2000:0,purity=state.options.some(v=>/^18\s*K$/i.test(v))?15000:0;return {base,color,clarity,purity,total:base+color+clarity+purity}}
function renderTotals(){if(!activeVariant)return;const p=priceParts();$('#price').textContent=money(p.total/100);$('#price-addons').textContent='Ürün '+money(p.base/100)+' + '+state.color+' '+money(p.color/100)+' + '+state.clarity+' '+money(p.clarity/100)+(p.purity?' + 18K '+money(p.purity/100):'')}
function renderDiamondPreferences(){group($('#diamond-color'),'Pırlanta rengi tercihi',['D','E','F'],state.color,v=>{state.color=v;renderDiamondPreferences();renderTotals();save()});group($('#diamond-clarity'),'Berraklık tercihi',['VS1','VS2'],state.clarity,v=>{state.clarity=v;renderDiamondPreferences();renderTotals();save()})}

function summaryData(){return {product:state.product.title,url:'https://metdiamond.com/products/'+state.product.handle+'?variant='+activeVariant.id,variantId:activeVariant.id,sku:activeVariant.sku,options:state.options,price:(priceParts().total/100).toFixed(2),basePrice:activeVariant.price,colorExtra:priceParts().color/100,clarityExtra:priceParts().clarity/100,purityExtra:priceParts().purity/100,currency:'USD',ringSizeUS:state.us,ringSizeEUApprox:sizes.find(x=>x[0]===state.us)[1],requestedColor:state.color,requestedClarity:state.clarity,preferencesRequireConfirmation:true,selectedImage:selectedMedia?.src||null,imageColor:selectedMedia?.color||null,imageReferenceCarat:selectedMedia?.carat||null,checkedAt:data.checkedAt}}
function chosenProductVideo(){const metal=selectedMetal().color;const idx=state.product.options.findIndex(o=>/carat/i.test(o.name));const carat=idx>=0?parseFloat(state.options[idx]):null;const exact=(state.product.videos||[]).filter(v=>v.color===metal&&v.carat===carat);const video=exact.find(v=>/\bLV\b|on[- ]?hand|hand video|elde/i.test(v.alt||''))||exact[0]||null;return {video,carat,metal,isHand:!!video&&/\bLV\b|on[- ]?hand|hand video|elde/i.test(video.alt||'')}}
function setProductVideo(el,note){const {video:v,carat,metal,isHand}=chosenProductVideo();el.pause();el.onerror=null;const same=el.getAttribute('src')===v?.src;el.hidden=!v;if(!v){el.removeAttribute('src');el.load();note.textContent='';note.hidden=true;const heading=el.parentElement.querySelector('h2,h3');if(heading)heading.hidden=true;return null}note.hidden=false;const heading=el.parentElement.querySelector('h2,h3');if(heading){heading.hidden=false;heading.textContent=isHand?'Yüzüğünüz elde nasıl görünüyor?':'Yüzüğünüzü yakından keşfedin'}if(!same){el.src=v.src;el.load()}el.poster=selectedMedia?.src||'';el.setAttribute('aria-label',state.product.title+(isHand?' · elde çekim':' · ürün videosu'));note.textContent=(isHand?'Seçilen ürünün elde çekilmiş videosu.':'Seçilen ürüne ait katalog videosu; elde çekim ayrıca doğrulanmadı.')+(v.carat&&v.carat!==carat?' Referans video '+v.carat+' ct; seçiminiz '+carat+' ct.':'')+(!v.color?' Videodaki altın rengi doğrulanmadı.':'');el.onerror=()=>{note.textContent='Video yüklenemedi. Lütfen tekrar deneyin.'};return v}
function renderFinalVideo(){const el=$('#review-video');const v=setProductVideo(el,$('#video-note'));$('#video-play').hidden=!v;$('#video-open').hidden=!v;if(!v){$('#video-open').removeAttribute('href');return}$('#video-open').href=v.src;$('#video-play').textContent='▶ '+(chosenProductVideo().isHand?'ELDE ÇEKİM VİDEOSUNU OYNAT':'ÜRÜN VİDEOSUNU OYNAT');$('#video-play').onclick=()=>el.play().catch(()=>{$('#video-note').textContent='Videoyu ayrı aç bağlantısını deneyin.'});el.play().catch(()=>{})}
function renderReview(){if(!activeVariant)return;$('#review-title').textContent=state.product.title;$('#review-image').hidden=!selectedMedia;$('#review-media-empty').hidden=!!selectedMedia;if(selectedMedia){$('#review-image').src=selectedMedia.src;$('#review-image').alt=state.product.title+(selectedMedia.reference?' · Rengi doğrulanmamış katalog referansı':' · '+label(selectedMetal().value));$('#review-image').dataset.color=selectedMedia.color||'unverified'}else{$('#review-image').removeAttribute('src');$('#review-media-empty').textContent=$('#media-empty').textContent}const details=state.product.options.map((o,i)=>[optionLabel(o.name),label(state.options[i])]);details.push(['Ölçü tercihi','US '+state.us+' / EU ≈ '+sizes.find(x=>x[0]===state.us)[1]],['Renk tercihi',state.color+' · Mağazada doğrulanacak'],['Berraklık tercihi',state.clarity+' · Mağazada doğrulanacak'],['SKU',activeVariant.sku||'—']);$('#review-details').replaceChildren();for(const [k,v] of details){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=k;dd.textContent=v;$('#review-details').append(dt,dd)}$('#review-style').textContent=state.style+' · '+state.product.shapes.join(' / ');$('#review-photo-note').textContent=$('#photo-note').textContent;$('#review-stock').textContent=(activeVariant.available?'Katalogda mevcut':'Katalogda stokta yok')+' · '+data.checkedAt+' · Güncel fiyat ve stok mağazada doğrulanır.';renderTotals();const costs=priceParts();$('#review-price').textContent=money(costs.total/100);$('#review-breakdown').replaceChildren();for(const [k,v] of [['Ürün fiyatı',costs.base],['Pırlanta rengi · '+state.color,costs.color],['Berraklık · '+state.clarity,costs.clarity],['18 ayar ek ücreti',costs.purity]]){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=k;dd.textContent=money(v/100);$('#review-breakdown').append(dt,dd)}renderFinalVideo();$('#package-product').textContent=state.product.title;$('#package-ring').hidden=!selectedMedia;if(selectedMedia)$('#package-ring').src=selectedMedia.src;else $('#package-ring').removeAttribute('src');$('#add-cart').disabled=!activeVariant.available||!selectedMedia;$('#cart-status').textContent='';}
$('#prev').onclick=()=>{state.page--;renderCatalog();window.scrollTo({top:350,behavior:'smooth'})};$('#next').onclick=()=>{state.page++;renderCatalog();window.scrollTo({top:350,behavior:'smooth'})};document.querySelectorAll('[data-step]').forEach(b=>b.onclick=()=>setStep(Number(b.dataset.step)));$('#back-catalog').onclick=()=>setStep(0);$('#back-configure').onclick=()=>setStep(1);$('#review-button').onclick=()=>setStep(2);$('#reset').onclick=()=>selectProduct(state.product);$('#us-size').onchange=()=>{state.us=Number($('#us-size').value);renderSize();save()};$('#size').onchange=()=>{state.us=Number($('#size').value);renderSize();save()};function summaryText(){const d=summaryData();return ['MET DIAMOND · Tasarım özeti',d.product,'Stil: '+state.style,...state.product.options.map((o,i)=>optionLabel(o.name)+': '+label(state.options[i])),'Ölçü tercihi: US '+d.ringSizeUS+' / yaklaşık EU '+d.ringSizeEUApprox,'Pırlanta rengi tercihi: '+d.requestedColor,'Berraklık tercihi: '+d.requestedClarity,'SKU: '+d.sku,'Ürün fiyatı: '+money(Number(d.basePrice)),'Renk ek ücreti: '+money(d.colorExtra),'Berraklık ek ücreti: '+money(d.clarityExtra),'18 ayar ek ücreti: '+money(d.purityExtra),'Tasarım toplamı: '+money(Number(d.price)),'Katalog tarihi: '+d.checkedAt,'Ürün: '+d.url,'','Ölçü, renk ve berraklık mağazada ayrıca seçilip doğrulanmalıdır. Güncel fiyat ve stok mağazada kontrol edilir. Bu özet sipariş veya fiyat teklifi değildir.'].join('\n')}
$('#edit-mount').onclick=()=>setStep(0);$('#edit-options').onclick=()=>{setStep(1);$('#options button').focus()};

let addingToCart=false;
$('#add-cart').onclick=async()=>{if(addingToCart||!activeVariant)return;addingToCart=true;const button=$('#add-cart'),status=$('#cart-status');button.disabled=true;button.textContent='SEPETE EKLENİYOR…';status.textContent='Güncel fiyat ve stok kontrol ediliyor…';try{
 if(location.protocol==='file:')throw Error('Sepet testi Shopify taslak bağlantısında yapılabilir.');
 const root=window.Shopify?.routes?.root||'/';
 const [productResponse,cartResponse,feeResponse]=await Promise.all([fetch(root+'products/'+state.product.handle+'.js'),fetch(root+'cart.js'),fetch(root+'products/met-ring-design-adjustment.js')]);
 if(!productResponse.ok||!cartResponse.ok||!feeResponse.ok)throw Error('Ürün veya ek ücret bilgisi alınamadı. Tekrar deneyin.');
 const live=await productResponse.json(),cart=await cartResponse.json(),fee=await feeResponse.json();if(cart.currency!=='USD')throw Error('Bu taslak sepet testi USD para birimiyle kullanılabilir.');
 const variant=live.variants.find(v=>String(v.id)===String(activeVariant.id));if(!variant?.available)throw Error('Seçilen varyant şu anda satışa uygun değil.');
 const expected=priceParts().total,extra=expected-variant.price;const feeVariant=fee.variants.find(v=>v.price===extra);if(extra<0||extra%100!==0||extra>50000||!feeVariant?.available||feeVariant.price!==extra)throw Error('Güncel fiyat tasarım toplamıyla uyuşmuyor. Ürünü tekrar seçip deneyin.');
 const group=crypto.randomUUID();const properties={'Ring Size':'US '+state.us,'EU Size (approx)':String(sizes.find(x=>x[0]===state.us)[1]),'Diamond Color':state.color,'Diamond Clarity':state.clarity,'Design Total':money(expected/100),'_met_design':group};
 const items=[{id:variant.id,quantity:1,properties}];if(extra)items.push({id:feeVariant.id,quantity:1,parent_id:variant.id,properties:{'For ring':activeVariant.sku,'Diamond Color':state.color,'Diamond Clarity':state.clarity,'Gold Purity':state.options.find(v=>/^1[48]K$/.test(v)),'_met_design':group}});
 const response=await fetch(root+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items})});const result=await response.json();if(!response.ok)throw Error(result.description||'Sepete eklenemedi.');
 const confirmed=await fetch(root+'cart.js').then(r=>r.json());const lines=confirmed.items.filter(x=>x.properties?._met_design===group);if(lines.reduce((sum,x)=>sum+x.original_line_price,0)!==expected)throw Error('Sepet toplamı doğrulanamadı. Sepetinizi kontrol edin.');
 status.textContent='Ürün ve ek ücretler sepete eklendi.';location.assign(root+'cart');
 }catch(e){status.textContent=e.message}finally{addingToCart=false;button.disabled=false;button.textContent='SEPETE EKLE'}};


document.querySelector('.brand-nav a[href="#style-panel"]').onclick=e=>{e.preventDefault();setStep(-1)};
function flow(diamond){$('#start-setting').setAttribute('aria-pressed',String(!diamond));$('#start-diamond').setAttribute('aria-pressed',String(diamond));const parent=$('#styles').parentElement;parent.insertBefore($(diamond?'#shapes':'#styles'),parent.firstElementChild)}$('#start-setting').onclick=()=>flow(false);$('#start-diamond').onclick=()=>flow(true);
try{const saved=JSON.parse(localStorage.getItem('met-ring-v3'));if(saved){if(saved.style===''||data.styles[saved.style])state.style=saved.style;if(saved.shape===''||data.shapes[saved.shape])state.shape=saved.shape;if(sizes.some(x=>x[0]===saved.us))state.us=saved.us;state.system=saved.system==='EU'?'EU':'US';if(['D','E','F'].includes(saved.color))state.color=saved.color;if(['VS1','VS2'].includes(saved.clarity))state.clarity=saved.clarity;const p=data.products.find(p=>p.id===saved.product);if(p&&Array.isArray(saved.options)){state.options=saved.options;selectProduct(p,true)}}}catch{}renderDiamondPreferences();renderStyleCards();renderCatalog();setStep(-1);const sample=null;if(sample==='0308'){const demo=data.products.find(p=>p.title.includes('MET 0308'));if(demo){state.style=demo.displayStyle;selectProduct(demo);setStep(2)}}$('#loading').hidden=true;$('#app').hidden=false;
}catch(e){document.querySelector('#loading').hidden=true;document.querySelector('#error').hidden=false;document.querySelector('#error').textContent='Önizleme yüklenemedi. Güncel Chrome veya Safari ile tekrar açın.';console.error(e)}})();
</script></body></html>




