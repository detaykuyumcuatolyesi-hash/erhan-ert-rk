span><button class="back" id="edit-options">Düzenle</button></div><dl id="review-details"></dl><div class="review-edit"><span>TASARIM TOPLAMI</span></div><dl id="review-breakdown"></dl><div id="review-price" class="price"></div><p id="review-stock" class="muted"></p><button id="prepare-handoff" class="cta">TERCİHLERİ KOPYALA VE DEVAM ET</button><p id="handoff-status" class="muted" role="status" aria-live="polite">Ölçü, renk ve berraklık tercihlerinizi mağazada paylaşmak için önce kopyalayın.</p><a id="product-link" class="outline" style="display:block;text-align:center;text-decoration:none;margin-top:10px" target="_blank" rel="noopener">SEÇİLEN VARYANTI MAĞAZADA AÇ ↗</a><button id="download" class="outline" style="width:100%;margin-top:10px">Tasarım özetini indir</button><button id="copy-summary" class="outline" style="width:100%;margin-top:8px">Özeti kopyala</button><p id="copy-status" class="muted" role="status"></p></div></div><p class="review-note">Ürün bağlantısı karat ve altın seçeneklerini seçilen gerçek varyantla açar. Ölçü, D/E/F renk ve VS1/VS2 berraklık tercihlerini mağazada ayrıca belirtin. Bu önizleme sepete ürün eklemez. Toplam, ürün fiyatı ile seçilen renk ve berraklık ek ücretlerini içerir. 18 ayar seçimine 150 $ eklenir. Ek ücretler henüz mağaza sepetine bağlı değildir.</p></div></section><p class="saved" id="saved-status" role="status"></p></main><div class="footer">20 Ekim 2026 · 7 stil ve 9 taş şekli koleksiyonunun tüm sayfaları tarandı.<br>Fotoğraflar MET DIAMOND ürün galerilerinden alınmıştır. Mağaza fiyatları ve stokları değişebilir.</div><footer>MET DIAMOND</footer><script src="{{ 'met-ring-catalog.js' | asset_url }}"></script><script>
(async()=>{try{
const bytes=Uint8Array.from(atob(window.MET_RING_CATALOG),c=>c.charCodeAt(0));const data=JSON.parse(await new Response(new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'))).text());
const $=s=>document.querySelector(s),money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(n);
const state={style:'',shape:'',query:'',sort:'default',page:0,product:null,options:[],us:6,system:'US',color:'D',clarity:'VS1',step:0,mediaAngle:'fp_00002'};let activeVariant=null;let selectedMedia=null;
const sizes=[[3,44],[4,47],[4.5,48],[5,49],[6,52],[6.5,53],[7,54],[8,57],[8.5,58],[9.5,61],[10,62],[10.5,63],[11.5,66],[12,67]];
const optionLabel=n=>({'Center stone carat':'Merkez taş karatı','Gold purity':'Altın ayarı','Gold color':'Altın rengi'}[n]||n);
const label=v=>({'White Gold':'Beyaz altın','Yellow Gold':'Sarı altın','Rose Gold':'Rose altın'}[v]||v);

function renderStyleCards(){
 $('#style-cards').replaceChildren();const usedImages=new Set();
 for(const [name,handle] of Object.entries(data.styles)){
  const products=data.products.filter(p=>p.displayStyle===name);
  const b=document.createElement('button');b.type='button';b.className='card style-card';b.setAttribute('aria-label',name+' stilini seç');b.setAttribute('aria-pressed',String(state.style===name));
  const roundProducts=products.filter(p=>p.shapes.includes('Oval'));const exact=roundProducts.find(p=>p.title.toLocaleLowerCase('tr').includes(name.toLocaleLowerCase('tr'))&&!usedImages.has(p.images[0]));const representative=exact||roundProducts.find(p=>!usedImages.has(p.images[0]))||roundProducts[0];const src=data.styleCardOverrides?.[name]?.image||representative?.images[0];if(src)usedImages.add(src);
  if(src){const img=document.createElement('img');img.src=src;img.alt=name+' stili · Oval taş şekli';img.loading='eager';b.append(img)}
  else{const empty=document.createElement('div');empty.className='style-no-image';empty.textContent=name;b.append(empty)}
  const caption=document.createElement('span');caption.className='caption';const title=document.createElement('strong');title.textContent=name;const count=document.createElement('span');count.className='money';count.textContent=products.length?products.length+' montür · Keşfedin →':'Koleksiyonda henüz ürün yok';caption.append(title,count);b.append(caption);
  b.onclick=()=>{state.style=name;state.shape='';state.query='';state.page=0;state.product=null;state.options=[];activeVariant=null;$('#search').value='';renderStyleCards();renderCatalog();setStep(0)};
  $('#style-cards').append(b)
 }
}
$('#back-style').onclick=()=>{renderStyleCards();setStep(-1)};
function minPrice(p){const n=p.variants.map(v=>Number(v.price)).filter(Number.isFinite);return n.length?Math.min(...n):Infinity}
function setStep(step){if(step!==2)$('#review-video')?.pause();if(step>=0&&!state.style)return;if(step>0&&!state.product)return;if(step===2&&!activeVariant)return;state.step=step;$('#style-panel').hidden=step!==-1;$('#catalog-panel').hidden=step!==0;$('#configure-panel').hidden=step!==1;$('#review-panel').hidden=step!==2;document.querySelectorAll('[data-step]').forEach(b=>{b.setAttribute('aria-current',Number(b.dataset.step)===step?'step':'false');b.disabled=Number(b.dataset.step)>=0&&!state.style||Number(b.dataset.step)>0&&!state.product||Number(b.dataset.step)===2&&!activeVariant});if(step===2)renderReview();save();window.scrollTo({top:180,behavior:'smooth'})}
function save(){try{localStorage.setItem('met-ring-v3',JSON.stringify({...state,product:state.product?.id}));$('#saved-status').textContent='Seçimleriniz bu tarayıcıda kaydedildi.'}catch{$('#saved-status').textContent=''}}
function group(host,title,values,current,onchange,counts){host.replaceChildren();const f=document.createElement('fieldset'),l=document.createElement('legend');l.textContent=title;f.append(l);const wrap=document.createElement('div');wrap.className='choices';values.forEach(v=>{const b=document.createElement('button');b.type='button';b.textContent=(v||'Tümü')+(counts&&v?' · '+counts(v):'');b.setAttribute('aria-pressed',String(v===current));b.onclick=()=>onchange(v);wrap.append(b)});f.append(wrap);host.append(f)}
function matches(){let r=data.products.filter(p=>(!state.style||p.displayStyle===state.style)&&(!state.shape||p.shapes.includes(state.shape))&&(!state.query||(p.title+' '+p.variants.map(v=>v.sku).join(' ')).toLocaleLowerCase('tr').includes(state.query.toLocaleLowerCase('tr'))));if(state.sort!=='default')r.sort((a,b)=>state.sort==='asc'?minPrice(a)-minPrice(b):minPrice(b)-minPrice(a));return r}
function renderCatalog(){$('#styles').hidden=true;$('#selected-style').textContent=state.style+' · Montürünüzü seçin';group($('#styles'),'Stil',Object.keys(data.styles),state.style,v=>{state.style=v;state.page=0;renderCatalog()},v=>data.products.filter(p=>p.displayStyle===v&&(!state.shape||p.shapes.includes(state.shape))).length);group($('#shapes'),'Taş şekli',['',...Object.keys(data.shapes)],state.shape,v=>{state.shape=v;state.page=0;renderCatalog()},v=>data.products.filter(p=>p.shapes.includes(v)&&(!state.style||p.displayStyle===state.style)).length);const rows=matches(),pages=Math.max(1,Math.ceil(rows.length/12));state.page=Math.min(state.page,pages-1);$('#count').textContent=rows.length+' yüzük · Toplam '+data.products.filter(p=>p.displayStyle).length+' sınıflandırılmış ürün';$('#page').textContent=(state.page+1)+' / '+pages;$('#prev').disabled=state.page===0;$('#next').disabled=state.page>=pages-1;$('#collection-link').href=state.style==='East West'?'https://metdiamond.com/search?q=east+west&type=product':'https://metdiamond.com/collections/'+(data.styles[state.style]||data.shapes[state.shape]||'all');$('#cards').replaceChildren();for(const p of rows.slice(state.page*12,state.page*12+12)){const b=document.createElement('button');b.type='button';b.className='card';b.setAttribute('aria-label',p.title+' — tasarla');const img=document.createElement('img');img.src=p.images[0];img.alt=p.title;img.loading='lazy';const caption=document.createElement('span');caption.className='caption';caption.textContent=p.title;const cost=document.createElement('span');cost.className='money';cost.textContent=Number.isFinite(minPrice(p))?money(minPrice(p))+' itibarıyla':'Fiyatı incele';caption.append(cost);b.append(img,caption);b.onclick=()=>selectProduct(p);$('#cards').append(b)}if(!rows.length){const e=document.createElement('div');e.className='empty';e.textContent=state.style==='Vintage'?'Vintage koleksiyonu mağazada şu anda ürün döndürmüyor. Diğer stilleri inceleyebilirsiniz.':'Bu filtrelerde eşleşen ürün yok. Stil veya şekil filtresini değiştirebilirsiniz.';$('#cards').append(e)}save()}
function selectProduct(p,restore=false){state.product=p;if(!restore){const v=p.variants.find(v=>v.available)||p.variants[0];state.options=p.options.map((o,i)=>v?.['option'+(i+1)]||'')}$('#title').textContent=p.title;renderOptions();renderSize();updateVariant();if(!restore)setStep(1)}
function renderOptions(){const p=state.product;$('#options').replaceChildren();p.options.forEach((o,i)=>{const host=document.createElement('div');$('#options').append(host);const vals=[...new Set(p.variants.map(v=>v['option'+(i+1)]).filter(Boolean))];group(host,optionLabel(o.name),vals,state.options[i],v=>{state.options[i]=v;const others=p.variants.filter(r=>r['option'+(i+1)]===v);if(!others.some(r=>state.options.every((x,j)=>r['option'+(j+1)]===x))){const best=others.find(r=>r.available)||others[0];if(best)state.options=p.options.map((_,j)=>best['option'+(j+1)])}renderOptions();updateVariant()});host.querySelectorAll('button').forEach((b,j)=>b.textContent=label(vals[j]))})}
function selectedMetal(){const i=state.product.options.findIndex(o=>/gold color|metal colo[u]?r/i.test(o.name));const value=i>=0?state.options[i]:'';return {value,color:({'White Gold':'white','Yellow Gold':'yellow','Rose Gold':'rose'})[value]||null}}
let photoAttempt=0;
function setHeroMedia(media){const attempt=++photoAttempt;const hero=$('#hero');hero.onload=()=>{if(attempt===photoAttempt)hero.style.opacity='1'};hero.onerror=()=>{if(attempt!==photoAttempt)return;hero.hidden=true;$('#media-empty').hidden=false;$('#media-empty').textContent='Fotoğraf yüklenemedi. Küçük görsellerden başka bir kare seçin veya tekrar deneyin.';$('#image-reference').hidden=true};
 selectedMedia=media;const metal=selectedMetal();$('#image-reference').hidden=!media?.reference;$('#hero').hidden=!media;$('#media-empty').hidden=!!media;
 if(media){$('#hero').src=media.src;$('#hero').alt=state.product.title+(media.reference?' · Katalog referans görseli, altın rengi doğrulanmadı':' · '+label(metal.value));$('#hero').dataset.color=media.color||'unverified';const idx=state.product.options.findIndex(o=>/carat/i.test(o.name));const carat=idx>=0?parseFloat(state.options[idx]):null;
  const assigned=media.variantIds?.includes(activeVariant?.id);$('#photo-note').textContent=media.reference?'Bu fotoğraf seçilen ürüne aittir. Seçtiğiniz '+label(metal.value).toLocaleLowerCase('tr')+' rengi ve taş boyutuyla eşleşmesi doğrulanmadı.':'Seçilen '+label(metal.value).toLocaleLowerCase('tr')+' rengine ait gerçek ürün fotoğrafı.'+(assigned?'':media.carat&&media.carat!==carat?' Görsel '+media.carat+' ct referansıdır; seçiminiz '+carat+' ct.':!media.carat?' Bu karedeki taş boyutu ayrıca doğrulanmadı.':'');
 }else{$('#hero').removeAttribute('src');$('#hero').dataset.color='';$('#media-empty').textContent=label(metal.value)+' için doğrulanmış fotoğraf henüz yok.';$('#photo-note').textContent='Seçilen rengin fotoğrafı bulunmadığından başka renkte ürün gösterilmiyor.'}
 $('#thumbs').querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(media&&b.dataset.src===media.src)))
}
function renderColorGallery(){
 const p=state.product,metal=selectedMetal();let items=(p.colorMedia||[]).filter(m=>m.color===metal.color);if(!items.length)items=(p.images||[]).slice(0,5).map((src,i)=>({src,color:null,carat:null,angle:'reference-'+i,reference:true}));$('#thumbs').replaceChildren();
 const i=p.options.findIndex(o=>/carat/i.test(o.name));const carat=i>=0?parseFloat(state.options[i]):null;
 const assigned=items.find(m=>m.variantIds?.includes(activeVariant?.id));
 const preferred=assigned||items.find(m=>m.angle===state.mediaAngle&&m.carat===carat)||items.find(m=>m.angle===state.mediaAngle)||items.find(m=>m.carat===carat)||items[0]||null;
 for(const [n,m] of items.entries()){const b=document.createElement('button');b.type='button';b.dataset.src=m.src;b.setAttribute('aria-label',(m.reference?'Katalog referansı':label(metal.value))+' fotoğraf '+(n+1));const img=document.createElement('img');img.src=m.src;img.alt=m.reference?'Ürün katalog referansı':label(metal.value);img.dataset.color=m.color;img.loading='lazy';b.append(img);b.onclick=()=>{state.mediaAngle=m.angle;setHeroMedia(m);save()};$('#thumbs').append(b)}
 setHeroMedia(preferred)
}
function updateVariant(){const p=state.product;if(!p)return;activeVariant=p.variants.find(v=>state.options.every((x,i)=>v['option'+(i+1)]===x))||null;$('#price').textContent=activeVariant?money(Number(activeVariant.price)):'Varyant bulunamadı';$('#variant-status').textContent=activeVariant?(activeVariant.available?'Seçilen varyant katalogda mevcut.':'Seçilen varyant şu anda stokta yok.'):'Seçenekleri kontrol edin.';$('#sku').textContent=activeVariant?.sku||'';$('#review-button').disabled=!activeVariant;renderColorGallery();renderTotals();save()}

function renderSize(){
 $('#us-size').replaceChildren();$('#size').replaceChildren();
 for(const [us,eu] of sizes){const a=document.createElement('option');a.value=String(us);a.textContent='US '+us;$('#us-size').append(a);const b=document.createElement('option');b.value=String(us);b.textContent='EU ≈ '+eu;$('#size').append(b)}
 $('#us-size').value=String(state.us);$('#size').value=String(state.us);
 $('#size-note').textContent='US '+state.us+' / yaklaşık EU '+sizes.find(x=>x[0]===state.us)[1]+'. İki alan aynı ölçüyü gösterir; birini değiştirince diğeri güncellenir. Listedeki ölçüler rehberde doğrulanan eşleştirmelerdir.'
}
function priceParts(){const base=Math.round(Number(activeVariant?.price||0)*100),color=({D:4000,E:3000,F:2000})[state.color]||0,clarity=state.clarity==='VS1'?2000:0,purity=state.options.some(v=>/^18\s*K$/i.test(v))?15000:0;return {base,color,clarity,purity,total:base+color+clarity+purity}}
function renderTotals(){if(!activeVariant)return;const p=priceParts();$('#price').textContent=money(p.total/100);$('#price-addons').textContent='Ürün '+money(p.base/100)+' + '+state.color+' '+money(p.color/100)+' + '+state.clarity+' '+money(p.clarity/100)+(p.purity?' + 18K '+money(p.purity/100):'')}
function renderDiamondPreferences(){group($('#diamond-color'),'Pırlanta rengi tercihi',['D','E','F'],state.color,v=>{state.color=v;renderDiamondPreferences();renderTotals();save()});group($('#diamond-clarity'),'Berraklık tercihi',['VS1','VS2'],state.clarity,v=>{state.clarity=v;renderDiamondPreferences();renderTotals();save()})}

function summaryData(){return {product:state.product.title,url:'https://metdiamond.com/products/'+state.product.handle+'?variant='+activeVariant.id,variantId:activeVariant.id,sku:activeVariant.sku,options:state.options,price:(priceParts().total/100).toFixed(2),basePrice:activeVariant.price,colorExtra:priceParts().color/100,clarityExtra:priceParts().clarity/100,purityExtra:priceParts().purity/100,currency:'USD',ringSizeUS:state.us,ringSizeEUApprox:sizes.find(x=>x[0]===state.us)[1],requestedColor:state.color,requestedClarity:state.clarity,preferencesRequireConfirmation:true,selectedImage:selectedMedia?.src||null,imageColor:selectedMedia?.color||null,imageReferenceCarat:selectedMedia?.carat||null,checkedAt:data.checkedAt}}
function renderFinalVideo(){const el=$('#review-video');el.pause();el.removeAttribute('src');el.load();el.hidden=true;$('#video-open').hidden=true;$('#video-open').removeAttribute('href');el.onerror=null;const metal=selectedMetal().color;const carat=Number.parseFloat(state.options[0]);const videos=state.product.videos||[];const allowed=videos.filter(v=>!v.color||v.color===metal);const v=allowed.find(v=>v.color===metal&&v.carat===carat)||allowed.find(v=>v.color===metal)||allowed[0]||videos[0];if(!v){$('#video-note').textContent=videos.length?'Seçilen altın renginde video bulunmuyor.':'Bu ürüne ait video henüz bulunmuyor.';return}el.src=v.src;el.poster=selectedMedia?.src||'';el.hidden=false;$('#video-open').href=v.src;$('#video-open').hidden=false;el.play().catch(()=>{});el.setAttribute('aria-label',state.product.title+' ürün videosu');$('#video-note').textContent='Seçilen ürüne ait katalog videosu.'+(v.color&&v.color!==metal?' Referans videodaki altın rengi seçiminizle eşleşmiyor.':'')+(!v.color?' Videodaki altın rengi ayrıca doğrulanmadı.':'')+(v.carat&&v.carat!==carat?' Video '+v.carat+' ct referansıdır.':'');el.onerror=()=>{$('#video-note').textContent='Video burada oynatılamadı. Videoyu ayrı aç bağlantısını deneyin.'}}
function renderReview(){if(!activeVariant)return;$('#review-title').textContent=state.product.title;$('#review-image').hidden=!selectedMedia;$('#review-media-empty').hidden=!!selectedMedia;if(selectedMedia){$('#review-image').src=selectedMedia.src;$('#review-image').alt=state.product.title+(selectedMedia.reference?' · Rengi doğrulanmamış katalog referansı':' · '+label(selectedMetal().value));$('#review-image').dataset.color=selectedMedia.color||'unverified'}else{$('#review-image').removeAttribute('src');$('#review-media-empty').textContent=$('#media-empty').textContent}const details=state.product.options.map((o,i)=>[optionLabel(o.name),label(state.options[i])]);details.push(['Ölçü tercihi','US '+state.us+' / EU ≈ '+sizes.find(x=>x[0]===state.us)[1]],['Renk tercihi',state.color+' · Mağazada doğrulanacak'],['Berraklık tercihi',state.clarity+' · Mağazada doğrulanacak'],['SKU',activeVariant.sku||'—']);$('#review-details').replaceChildren();for(const [k,v] of details){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=k;dd.textContent=v;$('#review-details').append(dt,dd)}$('#review-style').textContent=state.style+' · '+state.product.shapes.join(' / ');$('#review-photo-note').textContent=$('#photo-note').textContent;$('#review-stock').textContent=(activeVariant.available?'Katalogda mevcut':'Katalogda stokta yok')+' · '+data.checkedAt+' · Güncel fiyat ve stok mağazada doğrulanır.';renderTotals();const costs=priceParts();$('#review-price').textContent=money(costs.total/100);$('#review-breakdown').replaceChildren();for(const [k,v] of [['Ürün fiyatı',costs.base],['Pırlanta rengi · '+state.color,costs.color],['Berraklık · '+state.clarity,costs.clarity],['18 ayar ek ücreti',costs.purity]]){const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=k;dd.textContent=money(v/100);$('#review-breakdown').append(dt,dd)}renderFinalVideo();$('#product-link').href=summaryData().url;$('#copy-status').textContent='';$('#handoff-status').textContent='Ölçü, renk ve berraklık tercihlerinizi mağazada paylaşmak için önce kopyalayın.';$('#prepare-handoff').textContent='TERCİHLERİ KOPYALA VE DEVAM ET'}
$('#search').oninput=()=>{state.query=$('#search').value;state.page=0;renderCatalog()};$('#sort').onchange=()=>{state.sort=$('#sort').value;state.page=0;renderCatalog()};$('#prev').onclick=()=>{state.page--;renderCatalog();window.scrollTo({top:350,behavior:'smooth'})};$('#next').onclick=()=>{state.page++;renderCatalog();window.scrollTo({top:350,behavior:'smooth'})};document.querySelectorAll('[data-step]').forEach(b=>b.onclick=()=>setStep(Number(b.dataset.step)));$('#back-catalog').onclick=()=>setStep(0);$('#back-configure').onclick=()=>setStep(1);$('#review-button').onclick=()=>setStep(2);$('#reset').onclick=()=>selectProduct(state.product);$('#us-size').onchange=()=>{state.us=Number($('#us-size').value);renderSize();save()};$('#size').onchange=()=>{state.us=Number($('#size').value);renderSize();save()};function summaryText(){const d=summaryData();return ['MET DIAMOND · Tasarım özeti',d.product,'Stil: '+state.style,...state.product.options.map((o,i)=>optionLabel(o.name)+': '+label(state.options[i])),'Ölçü tercihi: US '+d.ringSizeUS+' / yaklaşık EU '+d.ringSizeEUApprox,'Pırlanta rengi tercihi: '+d.requestedColor,'Berraklık tercihi: '+d.requestedClarity,'SKU: '+d.sku,'Ürün fiyatı: '+money(Number(d.basePrice)),'Renk ek ücreti: '+money(d.colorExtra),'Berraklık ek ücreti: '+money(d.clarityExtra),'18 ayar ek ücreti: '+money(d.purityExtra),'Tasarım toplamı: '+money(Number(d.price)),'Katalog tarihi: '+d.checkedAt,'Ürün: '+d.url,'','Ölçü, renk ve berraklık mağazada ayrıca seçilip doğrulanmalıdır. Güncel fiyat ve stok mağazada kontrol edilir. Bu özet sipariş veya fiyat teklifi değildir.'].join('\n')}
$('#edit-mount').onclick=()=>setStep(0);$('#edit-options').onclick=()=>{setStep(1);$('#options button').focus()};
$('#download').onclick=()=>{const blob=new Blob(['\ufeff'+summaryText()],{type:'text/plain;charset=utf-8'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='met-diamond-tasarim-'+(activeVariant.sku||'ozet')+'.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
$('#prepare-handoff').onclick=async()=>{const button=$('#prepare-handoff');button.disabled=true;try{await navigator.clipboard.writeText(summaryText());$('#handoff-status').textContent='Tercihleriniz kopyalandı. Aşağıdaki bağlantıdan ürünü açın; ölçü, renk ve berraklık tercihlerinizi mağazada paylaşın.';button.textContent='TERCİHLER KOPYALANDI ✓';$('#product-link').focus()}catch{$('#handoff-status').textContent='Kopyalama yapılamadı. Tasarım özetini indirip tercihlerinizi mağazada paylaşabilirsiniz.'}finally{button.disabled=false}};
$('#copy-summary').onclick=async()=>{try{await navigator.clipboard.writeText(summaryText());$('#copy-status').textContent='Tasarım özeti kopyalandı.'}catch{$('#copy-status').textContent='Bu tarayıcı kopyalamaya izin vermedi. Tasarım özetini indirebilirsiniz.'}};

document.querySelector('.brand-nav a[href="#style-panel"]').onclick=e=>{e.preventDefault();setStep(-1)};
function flow(diamond){$('#start-setting').setAttribute('aria-pressed',String(!diamond));$('#start-diamond').setAttribute('aria-pressed',String(diamond));const parent=$('#styles').parentElement;parent.insertBefore($(diamond?'#shapes':'#styles'),parent.firstElementChild)}$('#start-setting').onclick=()=>flow(false);$('#start-diamond').onclick=()=>flow(true);
try{const saved=JSON.parse(localStorage.getItem('met-ring-v3'));if(saved){if(saved.style===''||data.styles[saved.style])state.style=saved.style;if(saved.shape===''||data.shapes[saved.shape])state.shape=saved.shape;if(sizes.some(x=>x[0]===saved.us))state.us=saved.us;state.system=saved.system==='EU'?'EU':'US';if(['D','E','F'].includes(saved.color))state.color=saved.color;if(['VS1','VS2'].includes(saved.clarity))state.clarity=saved.clarity;const p=data.products.find(p=>p.id===saved.product);if(p&&Array.isArray(saved.options)){state.options=saved.options;selectProduct(p,true)}}}catch{}renderDiamondPreferences();renderStyleCards();renderCatalog();setStep(-1);const sample=new URLSearchParams(location.search).get('sample');if(sample==='0308'){const demo=data.products.find(p=>p.title.includes('MET 0308'));if(demo){state.style=demo.displayStyle;selectProduct(demo);setStep(2)}}$('#loading').hidden=true;$('#app').hidden=false;
}catch(e){document.querySelector('#loading').hidden=true;document.querySelector('#error').hidden=false;document.querySelector('#error').textContent='Önizleme yüklenemedi. Güncel Chrome veya Safari ile tekrar açın.';console.error(e)}})();
</script></body></html>
