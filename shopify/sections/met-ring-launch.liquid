<section class="met-ring-launch"><div class="met-ring-launch__image"><img src="https://cdn.shopify.com/s/files/1/0792/8102/9223/files/met-0143-2ct-white-fp_00002-a2eca1750b27.jpg?v=1792058613" width="900" height="900" loading="lazy" alt="MET DIAMOND oval engagement ring"></div><div class="met-ring-launch__copy"><p class="met-ring-launch__eyebrow">MET DIAMOND · DESIGN STUDIO</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p><p class="met-ring-launch__steps">Choose your style · Select your diamond · Make it yours</p><a href="/?view=design-your-ring">{{ section.settings.button | escape }} ↗</a></div></section>
{% stylesheet %}
.met-ring-launch{display:grid;grid-template-columns:1fr 1fr;max-width:1440px;margin:48px auto;background:#f7f7f9;color:#1a2a3f}.met-ring-launch__image{min-width:0;max-height:520px;background:#f4f4f6}.met-ring-launch img{display:block;width:100%;height:100%;max-height:520px;object-fit:contain}.met-ring-launch__copy{padding:55px;align-self:center}.met-ring-launch__eyebrow{font-size:11px;letter-spacing:2px;color:#9b7b53}.met-ring-launch h2{font-family:var(--font-heading--family,Georgia);font-size:46px;line-height:1.1;font-weight:400;margin:20px 0}.met-ring-launch__copy>p{line-height:1.7}.met-ring-launch__steps{font-size:12px;color:#62656a;margin:24px 0}.met-ring-launch a{display:inline-block;background:#1a2a3f;color:#fff;padding:17px 30px;text-decoration:none;font-size:12px;letter-spacing:1px}.met-ring-launch a:hover{background:#304e75}@media(max-width:749px){.met-ring-launch{grid-template-columns:1fr;margin:24px 15px}.met-ring-launch__image{max-height:320px}.met-ring-launch img{height:320px}.met-ring-launch__copy{padding:28px}.met-ring-launch h2{font-size:34px}}
{% endstylesheet %}
{% schema %}
{"name":"MET Ring Design Studio","settings":[{"type":"text","id":"heading","label":"Heading","default":"Your ring. Your story."},{"type":"textarea","id":"text","label":"Description","default":"Create a lab grown diamond ring that reflects your story. Explore seven styles, choose your diamond and finish with your favourite gold."},{"type":"text","id":"button","label":"Button","default":"Design Your Ring"}],"presets":[{"name":"MET Ring Design Studio"}]}
{% endschema %}